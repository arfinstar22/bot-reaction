# Semua token bot dari @BotFather, dipisah koma. Jumlah bot mengikuti jumlah token.
TG_TOKENS=123456:AAA,234567:BBB,345678:CCC,456789:DDD,567890:EEE

# Kosongkan untuk memakai channel dari post pertama.
# Channel publik: @username. Channel privat wajib prefix -100: -1001234567890.
# Jangan pakai angka polos tanpa -100.
CHANNEL_ID=

# Opsional.
# Sisakan 1 slot jenis reaction untuk bot pengirim (projectTumbnail) / subscriber.
# RESERVE_SLOTS=1
# REACTIONS_FILE=reactions.txt
# LOG_LEVEL=INFO
# Di Render, RENDER_EXTERNAL_URL otomatis mengaktifkan mode webhook di /webhook.
# Isi WEBHOOK_URL=polling jika ingin memaksa mode polling.
# WEBHOOK_URL=
# WEBHOOK_SECRET=
